# Multi-stage build for WhatsApp Worker (WAHA orchestrator)
FROM node:20-bullseye AS dependencies

WORKDIR /app

COPY package*.json ./
RUN npm install --production && npm cache clean --force

# Stage 2: Runtime
FROM node:20-bullseye

WORKDIR /app

RUN apt-get update && apt-get install -y \
  ca-certificates \
  dumb-init \
  --no-install-recommends \
  && rm -rf /var/lib/apt/lists/*

ENV HOME=/app

# Create necessary directories and set permissions
RUN groupadd -r nodejs && useradd -r -g nodejs nodejs && \
    mkdir -p logs && \
    chown -R nodejs:nodejs /app logs

# Copy dependencies
COPY --from=dependencies /app/node_modules ./node_modules

# Copy application code
COPY --chown=nodejs:nodejs . .

# Switch to non-root user. Access to /var/run/docker.sock (mounted at
# runtime so this worker can orchestrate sibling WAHA containers) is
# granted via the `group_add` entry in docker-compose.yaml, matching the
# host's docker group GID - not baked into the image, since that GID
# varies per host.
USER nodejs:nodejs

# Webhook server (receives callbacks from WAHA containers)
EXPOSE 3001

# Use dumb-init
ENTRYPOINT ["dumb-init", "--"]

# Start the worker
CMD ["node", "src/worker.js"]
