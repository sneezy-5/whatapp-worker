# ========================================
# WORKER CONFIGURATION
# ========================================

# Worker Identity
WORKER_ID=worker-1
WORKER_NAME="WhatsApp Worker 1"

# ========================================
# RABBITMQ CONFIGURATION
# ========================================

# RabbitMQ Connection
RABBITMQ_URL=amqp://guest:guest@213.199.54.136:5672

# Queue Names (must match backend configuration)
QUEUE_MESSAGE_SEND=whatsapp.message.send
QUEUE_MESSAGE_RECEIVE=whatsapp.message.receive
QUEUE_NUMBER_HEALTH=whatsapp.number.health
QUEUE_SESSION_UPDATE=whatsapp.session.update
QUEUE_WORKER_EVENTS=whatsapp.worker.events

# ========================================
# WAHA CONFIGURATION
# ========================================
# The worker creates one WAHA (WhatsApp HTTP API) Docker container per
# WhatsApp number, on the same Docker network as this worker.

# WAHA image to use for each per-number container
WAHA_IMAGE=devlikeapro/waha:latest

# Docker network shared by the worker and the WAHA containers it creates
DOCKER_NETWORK=whatsapp-network

# Port this worker's own webhook server listens on (receives WAHA callbacks)
WEBHOOK_PORT=3001

# Base URL WAHA containers use to reach this worker's webhook server,
# resolved via Docker DNS (compose service name). Only override for
# non-Docker/local setups.
WORKER_PUBLIC_URL=http://worker:3001

# ========================================
# WHATSAPP CONFIGURATION
# ========================================

# Health check interval (in milliseconds)
# Default: 60000 (1 minute)
HEALTH_CHECK_INTERVAL=60000

# ========================================
# LOGGING CONFIGURATION
# ========================================

# Log Level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Pretty print logs (true/false)
# Set to false in production for better performance
LOG_PRETTY=true

# ========================================
# ENVIRONMENT
# ========================================

# Environment: development, production
NODE_ENV=production

# ========================================
# NOTES
# ========================================
# 
# 1. Copy this file to .env and fill in your values
# 2. Never commit .env to version control
# 3. Keep RABBITMQ_URL synchronized with backend
# 4. Each worker must have a unique WORKER_ID
# 5. Queue names must match backend configuration exactly
# 6. The worker container needs /var/run/docker.sock mounted (see
#    docker-compose.yaml) to create/manage per-number WAHA containers
#
